{
  "name": "@unicorn-studio/snap-bridge",
  "version": "0.6.1",
  "description": "Tiny RN dev-dep that exposes the running app's nav state to the Unicorn Capture desktop tool over WebSocket. Framework-agnostic — caller pushes route/state via setSnapState.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./expo-router": {
      "types": "./src/expo-router.ts",
      "default": "./src/expo-router.ts"
    }
  },
  "files": ["src", "bin", "examples", "README.md"],
  "bin": {
    "snap-bridge-init": "./bin/snap-bridge-init.mjs",
    "snap-flows-scan": "./bin/snap-flows-scan.mjs",
    "snap-bridge-setup": "./bin/snap-bridge-setup.mjs",
    "snap-bridge-wrap-screen": "./bin/snap-bridge-wrap-screen.mjs"
  },
  "peerDependencies": {
    "react-native": "*"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
